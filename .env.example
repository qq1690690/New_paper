# Copy to .env for local testing (do not commit .env)
OPENAI_API_KEY=sk-...
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
RECIPIENT_EMAIL=you@gmail.com

# Optional: Google Sheets output (see README for setup). Without these, the
# digest still emails as normal and just skips the sheet append.
GOOGLE_SHEETS_ID=your-spreadsheet-id-from-the-url
# Paste the full downloaded service-account JSON key as a single line here.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
